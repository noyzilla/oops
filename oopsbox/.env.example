# ==============================================================================
# Oops Stack Environment Configuration (.env.example)
# ==============================================================================
# Declarative infrastructure settings default to oops.yaml (x-oops:).
# Use this file exclusively for secrets and machine-specific overrides.
# Rule: x-oops tree path maps to UPPERCASE with _ (e.g. x-oops.db.mysql_password -> OOPS_DB_MYSQL_PASSWORD)
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Secrets & Database Credentials
# ------------------------------------------------------------------------------
OOPS_SECRET=change_this_to_a_secure_token
OOPS_DB_MYSQL_PASSWORD=change_this_root_password
OOPS_DB_POSTGRES_PASSWORD=change_this_pg_password
OOPS_DB_REDIS_PASSWORD=change_this_redis_password

# ------------------------------------------------------------------------------
# Optional Ingress & Domain
# ------------------------------------------------------------------------------
OOPS_DOMAIN=oops.web.oops

# ------------------------------------------------------------------------------
# Optional Infrastructure Overrides (Defaults configured in oops.yaml x-oops)
# ------------------------------------------------------------------------------
# OOPS_STOP_TIMEOUT=30s
# OOPS_HEALTHCHECK_TIMEOUT=10m
# OOPS_HEALTHCHECK_INTERVAL=3s
# OOPS_BACKUP_DIR=./backups
# OOPS_BACKUP_RETENTION=7d
# OOPS_DNS_TLD=oops
# OOPS_DNS_UPSTREAMS=1.1.1.1:53,8.8.8.8:53
# OOPS_VOLUME_MOUNT_PREFIXES=/mnt,/media,/Volumes
