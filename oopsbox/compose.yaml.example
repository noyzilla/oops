# ==============================================================================
# Oops Remote Base Manifest Blueprint (compose.yaml.example)
# ==============================================================================
# Minimal infrastructure skeleton used to initialize /@<remote>/compose.yaml
# Provides the shared networks for application stacks running on this host.
# ==============================================================================
name: oops

networks:
  default:
    name: oops_default
  oops_edge:
    name: oops_edge
    driver: bridge
  oops_db:
    name: oops_db
    driver: bridge
  oops_storage:
    name: oops_storage
    driver: bridge
