#!/usr/bin/env bash
set -e

# Oopsbox Local Dev Tool for Linux
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
OOPSBOX_DIR="$(cd -P "$BIN_DIR/.." && pwd)"

cd "$OOPSBOX_DIR"

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

generate_password() {
    if command -v openssl >/dev/null 2>&1; then
        openssl rand -base64 15 | tr -dc 'A-Za-z0-9' | head -c 20
    else
        LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 20
    fi
}

set_active_box() {
    local box_path="$1"
    mkdir -p "$HOME/.oops"
    echo "$box_path" > "$HOME/.oops/active_box"
}

get_yaml_file() {
    for f in "oopsbox.yml" "oopsbox.yaml" "oops.yml" "oops.yaml"; do
        if [ -f "$f" ]; then
            echo "$f"
            return
        fi
    done
}

run_oops() {
    if command -v oops >/dev/null 2>&1; then
        oops "$@"
    elif [ -x "$BIN_DIR/oops" ]; then
        "$BIN_DIR/oops" "$@"
    elif [ -x "$OOPSBOX_DIR/../oops" ]; then
        "$OOPSBOX_DIR/../oops" "$@"
    else
        return 127
    fi
}

get_dns_tld() {
    local tld="${OOPS_DNS_TLD:-${DNS_TLD}}"
    if [ -z "$tld" ]; then
        local yaml_file=$(get_yaml_file)
        if [ -n "$yaml_file" ]; then
            tld=$(awk -F: '
                /^[[:space:]]*dns:[[:space:]]*$/ { in_sec=1; next }
                in_sec && /^[a-zA-Z]/ { in_sec=0 }
                in_sec && $1 ~ "^[[:space:]]*tld[[:space:]]*$" {
                    sub(/#.*/, "", $2); gsub(/[[:space:]]/, "", $2); print $2
                }
            ' "$yaml_file" 2>/dev/null | head -n 1)
        fi
    fi
    echo "${tld:-oops}"
}

update_static_hosts() {
    local host_ip=$(docker network inspect bridge -f '{{range .IPAM.Config}}{{.Gateway}}{{end}}' 2>/dev/null || true)
    if [ -z "$host_ip" ]; then
        host_ip="172.17.0.1"
    fi

    local tld=$(get_dns_tld)
    mkdir -p data/oops
    cat > data/oops/dns.records <<EOF
# ==============================================================================
# Oops Static DNS Records (Auto-generated by oopsbox)
# ==============================================================================
host.$tld   $host_ip
vm.$tld     $host_ip
EOF
    echo -e "${GREEN}✓ data/oops/dns.records updated (host.$tld -> $host_ip, vm.$tld -> $host_ip).${NC}"
}

cmd_install() {
    echo -e "${BLUE}==> [Linux] Installing Oopsbox Local Dev Environment...${NC}"

    if [ ! -f .env ]; then
        if [ -f .env.example ]; then
            echo -e "Creating .env with auto-generated secure credentials..."
            cp .env.example .env
            local secret=$(generate_password)
            local mysql_pass=$(generate_password)
            local pg_pass=$(generate_password)

            sed -i -e "s|OOPS_SECRET=.*|OOPS_SECRET=${secret}|g" \
                   -e "s|MYSQL_ROOT_PASSWORD=.*|MYSQL_ROOT_PASSWORD=${mysql_pass}|g" \
                   -e "s|POSTGRES_PASSWORD=.*|POSTGRES_PASSWORD=${pg_pass}|g" .env
            echo -e "${GREEN}✓ .env created successfully.${NC}"
        fi
    else
        echo -e "Existing .env found. Keeping current credentials."
    fi

    if [ ! -f oopsbox.yml ] && [ -f oopsbox.yml.example ]; then
        cp oopsbox.yml.example oopsbox.yml
        echo -e "${GREEN}✓ oopsbox.yml initialized from oopsbox.yml.example.${NC}"
    fi

    mkdir -p data backups data/oops
    echo -e "${GREEN}✓ Storage and data directories initialized.${NC}"

    # Register oopsbox to global system PATH
    echo -e "Registering 'oopsbox' to global system PATH..."
    if [ -d "/usr/local/bin" ] && [ -w "/usr/local/bin" ]; then
        ln -sf "$BIN_DIR/oopsbox" /usr/local/bin/oopsbox
        echo -e "${GREEN}✓ Symlink created: /usr/local/bin/oopsbox${NC}"
    elif sudo -n true 2>/dev/null || [ -n "$SUDO_USER" ]; then
        sudo ln -sf "$BIN_DIR/oopsbox" /usr/local/bin/oopsbox
        echo -e "${GREEN}✓ Symlink created: /usr/local/bin/oopsbox${NC}"
    else
        mkdir -p "$HOME/.local/bin"
        ln -sf "$BIN_DIR/oopsbox" "$HOME/.local/bin/oopsbox"
        echo -e "${GREEN}✓ Symlink created: $HOME/.local/bin/oopsbox${NC}"
    fi

    if docker info >/dev/null 2>&1; then
        update_static_hosts
    fi

    # Record active box state
    set_active_box "$OOPSBOX_DIR"

    echo -e "\n${GREEN}===============================================${NC}"
    echo -e "${GREEN}🎉 Oopsbox installation complete!${NC}"
    echo -e "You can now run ${BLUE}oopsbox${NC} from any terminal directory!"
    echo -e "Next steps:"
    echo -e "  1. Start services:     ${BLUE}oopsbox start${NC}"
    echo -e "  2. Install HTTPS cert: ${BLUE}oopsbox install-cert${NC}"
    echo -e "${GREEN}===============================================${NC}"
}

cmd_start() {
    if [ -f .env ]; then
        set -a
        source .env
        set +a
    fi

    # Check if Docker daemon is accessible
    if ! docker info >/dev/null 2>&1; then
        echo -e "${RED}❌ Error: Docker daemon is not accessible. Please ensure Docker is running.${NC}"
        exit 1
    fi

    update_static_hosts

    # Record active box state
    set_active_box "$OOPSBOX_DIR"

    echo -e "${BLUE}==> [Linux] Starting Oopsbox Environment...${NC}"
    if run_oops up; then
        :
    else
        echo -e "Starting stacks via docker compose fallback..."
        docker compose -f stacks/edge/compose.yml up -d
    fi
    echo -e "\n${GREEN}✨ Oopsbox is up and running!${NC}"
    echo -e "Use ${BLUE}oops${NC} to manage stacks and profiles (e.g. ${BLUE}oops up @lab${NC}, ${BLUE}oops switch${NC}, ${BLUE}oops status${NC})."
}

cmd_install_cert() {
    echo -e "${BLUE}==> [Linux] Installing Caddy Local Root CA Certificate...${NC}"
    local cert_src="data/caddy/pki/authorities/local/root.crt"
    local tmp_cert="backups/caddy-root.crt"

    if [ ! -f "$cert_src" ]; then
        if docker ps | grep -q "caddy-proxy"; then
            docker cp caddy-proxy:/data/caddy/pki/authorities/local/root.crt "$tmp_cert" 2>/dev/null || true
        fi
    else
        cp "$cert_src" "$tmp_cert"
    fi

    local cert_file="${tmp_cert:-$cert_src}"
    if [ ! -f "$cert_file" ]; then
        echo -e "${RED}❌ Error: Caddy root.crt not found. Run 'oopsbox start' first.${NC}"
        exit 1
    fi

    if [ -d "/usr/local/share/ca-certificates" ]; then
        sudo cp "$cert_file" /usr/local/share/ca-certificates/oops-caddy.crt
        sudo update-ca-certificates
        echo -e "${GREEN}✓ Certificate added to Linux system trust store.${NC}"
    elif command -v trust >/dev/null 2>&1; then
        sudo trust anchor "$cert_file"
        echo -e "${GREEN}✓ Certificate added via trust anchor.${NC}"
    fi

    rm -f "$tmp_cert"
}

cmd_stop() {
    echo -e "${YELLOW}==> [Linux] Stopping Oopsbox Environment...${NC}"
    if run_oops down; then
        :
    else
        echo -e "Stopping stacks via docker compose fallback..."
        for dir in stacks/apps stacks/tool stacks/db stacks/edge; do
            if [ -f "$dir/compose.yml" ]; then
                docker compose -f "$dir/compose.yml" down 2>/dev/null || true
            elif [ -f "$dir/compose.yaml" ]; then
                docker compose -f "$dir/compose.yaml" down 2>/dev/null || true
            fi
        done
    fi
    echo -e "${GREEN}✓ Oopsbox stopped.${NC}"
}

cmd_switch() {
    local target_raw="$1"
    if [ -z "$target_raw" ]; then
        echo -e "${RED}Error: Target oopsbox directory path is required.${NC}"
        echo -e "Usage: ${BLUE}oopsbox switch <path/to/oopsbox>${NC}"
        exit 1
    fi

    local target_path
    if [[ "$target_raw" == ~* ]]; then
        target_path="${target_raw/#\~/$HOME}"
    else
        target_path="$(cd "$target_raw" 2>/dev/null && pwd || echo "$target_raw")"
    fi

    if [ ! -d "$target_path" ]; then
        echo -e "${RED}Error: Directory not found: $target_path${NC}"
        exit 1
    fi

    if [ ! -d "$target_path/stacks" ] && [ ! -f "$target_path/oops.yml" ] && [ ! -f "$target_path/oopsbox.yml" ]; then
        echo -e "${RED}Error: $target_path is not a valid Oopsbox workspace (missing stacks/ or oops.yml).${NC}"
        exit 1
    fi

    echo -e "${BLUE}==> Switching Oopsbox context to: $target_path${NC}"

    # Step 1: Clean and tear down current containers to release names and ports
    echo -e "${YELLOW}==> Tearing down active containers from current workspace...${NC}"
    cmd_stop

    # Step 2: Re-link global CLI symlink
    local target_bin="$target_path/bin/oopsbox"
    if [ -f "$target_bin" ]; then
        if [ -d "/usr/local/bin" ] && [ -w "/usr/local/bin" ]; then
            ln -sf "$target_bin" /usr/local/bin/oopsbox
        elif [ -d "/usr/local/bin" ]; then
            sudo ln -sf "$target_bin" /usr/local/bin/oopsbox 2>/dev/null || true
        else
            mkdir -p "$HOME/.local/bin"
            ln -sf "$target_bin" "$HOME/.local/bin/oopsbox"
        fi
    fi

    # Record active box state
    set_active_box "$target_path"

    # Step 3: Start target environment
    echo -e "${BLUE}==> Booting up target environment...${NC}"
    (cd "$target_path" && ./bin/oopsbox start)

    echo -e "\n${GREEN}=======================================================${NC}"
    echo -e "${GREEN}✓ Successfully switched active Oopsbox to: $target_path${NC}"
    echo -e "To ensure 'oops' targets this box outside its directory, run:"
    echo -e "  export OOPSBOX_DIR=\"$target_path\""
    echo -e "${GREEN}=======================================================${NC}"
}

cmd_upgrade() {
    local target_ver="${1:-latest}"
    echo -e "${BLUE}==> Upgrading Oopsbox workstation scripts and example templates (${target_ver})...${NC}"

    command -v curl >/dev/null 2>&1 || { echo -e "${RED}Error: curl is required.${NC}" >&2; exit 1; }
    command -v tar >/dev/null 2>&1 || { echo -e "${RED}Error: tar is required.${NC}" >&2; exit 1; }

    local tmp_dir=$(mktemp -d)
    cleanup_upgrade() {
        rm -rf "$tmp_dir"
    }
    trap cleanup_upgrade EXIT

    local src_dir=""
    local download_url=""
    if [ "$target_ver" = "latest" ]; then
        download_url="https://github.com/noyzilla/oops/releases/latest/download/oopsbox.tar.gz"
    else
        download_url="https://github.com/noyzilla/oops/releases/download/${target_ver}/oopsbox.tar.gz"
    fi

    echo -e "==> Downloading Oopsbox blueprint from ${download_url}..."
    if curl -fsSL "$download_url" -o "$tmp_dir/oopsbox.tar.gz" 2>/dev/null && [ -s "$tmp_dir/oopsbox.tar.gz" ]; then
        mkdir -p "$tmp_dir/extracted"
        tar -xzf "$tmp_dir/oopsbox.tar.gz" -C "$tmp_dir/extracted"
        src_dir="$tmp_dir/extracted"
    else
        echo -e "==> Release artifact not found; falling back to GitHub main branch archive..."
        curl -fsSL https://github.com/noyzilla/oops/archive/refs/heads/main.tar.gz -o "$tmp_dir/oops.tar.gz"
        tar -xzf "$tmp_dir/oops.tar.gz" -C "$tmp_dir"
        src_dir="$tmp_dir/oops-main/oopsbox"
    fi

    if [ ! -d "$src_dir/bin" ]; then
        echo -e "${RED}Error: Invalid blueprint archive downloaded.${NC}" >&2
        exit 1
    fi

    echo -e "==> Updating bin/ scripts..."
    mkdir -p "$OOPSBOX_DIR/bin"
    cp -f "$src_dir/bin/"* "$OOPSBOX_DIR/bin/" 2>/dev/null || true
    chmod +x "$OOPSBOX_DIR/bin/"* 2>/dev/null || true

    # Download latest native oops CLI binary
    local arch_raw="$(uname -m)"
    local arch="amd64"
    case "$arch_raw" in
        arm64|aarch64) arch="arm64" ;;
        x86_64|amd64)  arch="amd64" ;;
    esac

    local cli_url=""
    if [ "$target_ver" = "latest" ]; then
        cli_url="https://github.com/noyzilla/oops/releases/latest/download/oops-linux-${arch}"
    else
        cli_url="https://github.com/noyzilla/oops/releases/download/${target_ver}/oops-linux-${arch}"
    fi

    echo -e "==> Downloading native Oops CLI binary (linux-${arch})..."
    if curl -fsSL "$cli_url" -o "$OOPSBOX_DIR/bin/oops" 2>/dev/null && [ -s "$OOPSBOX_DIR/bin/oops" ]; then
        chmod +x "$OOPSBOX_DIR/bin/oops"
        if [ -d "/usr/local/bin" ] && [ -w "/usr/local/bin" ]; then
            ln -sf "$OOPSBOX_DIR/bin/oops" /usr/local/bin/oops
        elif [ -d "$HOME/.local/bin" ]; then
            mkdir -p "$HOME/.local/bin"
            ln -sf "$OOPSBOX_DIR/bin/oops" "$HOME/.local/bin/oops"
        fi
        echo -e "${GREEN}✓ Native oops CLI binary upgraded successfully.${NC}"
    fi

    echo -e "==> Updating template and documentation files..."
    for tmpl in ".env.example" "oopsbox.yml.example" "README.md"; do
        if [ -f "$src_dir/$tmpl" ]; then
            cp -f "$src_dir/$tmpl" "$OOPSBOX_DIR/$tmpl"
        fi
    done

    # Re-link global CLI symlink
    if [ -d "/usr/local/bin" ] && [ -w "/usr/local/bin" ]; then
        ln -sf "$OOPSBOX_DIR/bin/oopsbox" /usr/local/bin/oopsbox
    elif [ -d "$HOME/.local/bin" ]; then
        mkdir -p "$HOME/.local/bin"
        ln -sf "$OOPSBOX_DIR/bin/oopsbox" "$HOME/.local/bin/oopsbox"
    fi

    echo -e "\n${GREEN}=======================================================${NC}"
    echo -e "${GREEN}✓ Oopsbox workstation scripts & templates successfully upgraded!${NC}"
    echo -e "  Location: $OOPSBOX_DIR"
    echo -e "${GREEN}=======================================================${NC}"
}

case "$1" in
    install)
        cmd_install
        ;;
    start)
        cmd_start
        ;;
    install-cert)
        cmd_install_cert
        ;;
    stop)
        cmd_stop
        ;;
    switch)
        cmd_switch "$2"
        ;;
    upgrade|update)
        cmd_upgrade "$2"
        ;;
    *)
        echo -e "${BLUE}Oopsbox Workstation Tool (Linux)${NC}"
        echo -e "Usage: oopsbox <command>"
        echo -e ""
        echo -e "Commands:"
        echo -e "  ${GREEN}install${NC}         Initialize .env, storage, and global PATH"
        echo -e "  ${GREEN}start${NC}           Configure networking/DNS hosts and boot oops"
        echo -e "  ${GREEN}install-cert${NC}    Install Caddy Local Root SSL certificate into trust store"
        echo -e "  ${GREEN}stop${NC}            Stop runtime services (runs oops down)"
        echo -e "  ${GREEN}switch <path>${NC}   Tear down current box, switch context, and start target oopsbox"
        echo -e "  ${GREEN}upgrade [tag]${NC}   Upgrade workstation scripts in bin/ and example templates in-place"
        echo -e ""
        echo -e "For managing stacks and profiles, use ${BLUE}oops <command>${NC} (e.g. oops up, oops switch, oops status)."
        ;;
esac
