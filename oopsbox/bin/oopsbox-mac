#!/usr/bin/env bash
set -e

# Oopsbox Local Dev Tool for macOS
# Resolve real directory path even if called via symlink
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
OOPSBOX_DIR="$(cd -P "$BIN_DIR/.." && pwd)"

cd "$OOPSBOX_DIR"

# Color formatting
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

generate_password() {
    if command -v openssl >/dev/null 2>&1; then
        openssl rand -base64 15 | tr -dc 'A-Za-z0-9' | head -c 20
    else
        LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 20
    fi
}

get_dns_tld() {
    local tld="${OOPS_DNS_TLD:-${DNS_TLD}}"
    if [ -z "$tld" ]; then
        local yaml_file=$(get_yaml_file)
        if [ -n "$yaml_file" ]; then
            tld=$(awk -F: '
                /^[[:space:]]*dns:[[:space:]]*$/ { in_sec=1; next }
                in_sec && /^[a-zA-Z]/ { in_sec=0 }
                in_sec && $1 ~ "^[[:space:]]*tld[[:space:]]*$" {
                    sub(/#.*/, "", $2); gsub(/[[:space:]]/, "", $2); print $2
                }
            ' "$yaml_file" 2>/dev/null | head -n 1)
        fi
    fi
    echo "${tld:-oops}"
}

update_static_hosts() {
    local vm_ip="$1"
    local host_ip="$2"

    if [ -z "$vm_ip" ]; then
        local engine=$(detect_engine)
        if [ "$engine" = "colima" ] && command -v colima >/dev/null 2>&1 && colima status >/dev/null 2>&1; then
            vm_ip=$(colima ssh -- ip addr show col0 2>/dev/null | grep 'inet ' | awk '{ print $2 }' | cut -d/ -f1)
        elif [ "$engine" = "orbstack" ]; then
            vm_ip=$(docker network inspect bridge -f '{{range .IPAM.Config}}{{.Gateway}}{{end}}' 2>/dev/null || echo "127.0.0.1")
            host_ip="127.0.0.1"
        else
            vm_ip=$(docker network inspect bridge -f '{{range .IPAM.Config}}{{.Gateway}}{{end}}' 2>/dev/null || echo "127.0.0.1")
        fi
    fi

    if [ -n "$vm_ip" ]; then
        if [ -z "$host_ip" ]; then
            host_ip=$(echo "$vm_ip" | sed 's/\.[0-9]*$/\.1/')
        fi

        local tld=$(get_dns_tld)
        mkdir -p data/oops
        cat > data/oops/dns.records <<EOF
# ==============================================================================
# Oops Static DNS Records (Auto-generated by oopsbox)
# ==============================================================================
host.$tld   $host_ip
vm.$tld     $vm_ip
EOF
        echo -e "${GREEN}✓ data/oops/dns.records updated (host.$tld -> $host_ip, vm.$tld -> $vm_ip).${NC}"
    fi
}

get_yaml_file() {
    for f in "oopsbox.yml" "oopsbox.yaml" "oops.yml" "oops.yaml"; do
        if [ -f "$f" ]; then
            echo "$f"
            return
        fi
    done
}

run_oops() {
    if command -v oops >/dev/null 2>&1; then
        oops "$@"
    elif [ -x "$BIN_DIR/oops" ]; then
        "$BIN_DIR/oops" "$@"
    elif [ -x "$OOPSBOX_DIR/../oops" ]; then
        "$OOPSBOX_DIR/../oops" "$@"
    else
        return 127
    fi
}

get_config_value() {
    local key="$1"
    local yaml_file=$(get_yaml_file)
    if [ -n "$yaml_file" ]; then
        awk -F: -v k="$key" '
            /^[[:space:]]*engine:[[:space:]]*$/ { in_sec=1; next }
            in_sec && /^[a-zA-Z]/ { in_sec=0 }
            in_sec && $1 ~ "^[[:space:]]*" k "[[:space:]]*$" {
                sub(/#.*/, "", $2); gsub(/[[:space:]]/, "", $2); print $2
            }
        ' "$yaml_file" 2>/dev/null | head -n 1
    fi
}

detect_engine() {
    local target_engine="${OOPS_ENGINE_TYPE}"
    if [ -z "$target_engine" ]; then
        target_engine=$(get_config_value "type")
    fi

    target_engine="${target_engine:-auto}"

    if [ "$target_engine" = "auto" ]; then
        if command -v orb >/dev/null 2>&1 || [ -d "/Applications/OrbStack.app" ]; then
            echo "orbstack"
        elif command -v colima >/dev/null 2>&1; then
            echo "colima"
        else
            echo "docker"
        fi
    else
        echo "$target_engine"
    fi
}

get_colima_start_cmd() {
    local cpu="${OOPS_ENGINE_CPU}"
    local mem="${OOPS_ENGINE_MEMORY}"
    local disk="${OOPS_ENGINE_DISK}"
    local vm_type="${OOPS_ENGINE_VM_TYPE}"

    [ -z "$cpu" ] && cpu=$(get_config_value "cpu")
    [ -z "$mem" ] && mem=$(get_config_value "memory")
    [ -z "$disk" ] && disk=$(get_config_value "disk")
    [ -z "$vm_type" ] && vm_type=$(get_config_value "vm_type")

    cpu="${cpu:-4}"
    mem="${mem:-4}"
    vm_type="${vm_type:-vz}"

    if [ -n "$COLIMA_START_ARGS" ]; then
        echo "colima start ${COLIMA_START_ARGS}"
    else
        local cmd="colima start --cpu ${cpu} --memory ${mem} --vm-type=${vm_type} --network-address"
        if [ -n "$disk" ]; then
            cmd="${cmd} --disk ${disk}"
        fi
        echo "$cmd"
    fi
}

start_and_configure_engine() {
    local engine=$(detect_engine)
    echo -e "Detected engine runtime: ${BLUE}${engine}${NC}"

    case "$engine" in
        orbstack)
            if ! docker info >/dev/null 2>&1; then
                echo -e "🚀 Starting OrbStack..."
                if command -v orb >/dev/null 2>&1; then
                    orb start >/dev/null 2>&1 || true
                elif [ -d "/Applications/OrbStack.app" ]; then
                    open -a OrbStack
                fi

                local retries=0
                while ! docker info >/dev/null 2>&1 && [ $retries -lt 15 ]; do
                    sleep 1
                    retries=$((retries + 1))
                done
            fi
            if docker info >/dev/null 2>&1; then
                echo -e "${GREEN}✓ OrbStack engine is ready (Native container routing active).${NC}"
                update_static_hosts
            else
                echo -e "${RED}❌ Error: Could not connect to Docker via OrbStack.${NC}"
                exit 1
            fi
            ;;
        colima)
            if command -v colima >/dev/null 2>&1; then
                if ! colima status >/dev/null 2>&1; then
                    local colima_start_cmd=$(get_colima_start_cmd)
                    echo -e "🚀 Starting Colima VM (${colima_start_cmd})..."
                    eval "$colima_start_cmd"
                fi

                if ! colima ssh -- sudo iptables -n -L DOCKER-FORWARD >/dev/null 2>&1; then
                    echo -e "🌀 Restoring Docker daemon iptables chains in Colima VM..."
                    colima ssh -- sudo systemctl restart docker 2>/dev/null || true
                    sleep 2
                fi

                echo -e "🌀 Configuring Colima VM Network and Firewall..."
                colima ssh -- sudo pkill -f /usr/local/bin/fw-watcher.sh 2>/dev/null || true
                colima ssh << 'EOF' 2>/dev/null || true
sudo tee /usr/local/bin/fw-watcher.sh > /dev/null << 'INNER_EOF'
#!/bin/sh

apply_fw_rules() {
  for i in /proc/sys/net/ipv4/conf/*/rp_filter; do
    echo 0 > "$i" 2>/dev/null || true
  done
  sudo nft flush chain ip raw PREROUTING 2>/dev/null || true
  sudo iptables -D DOCKER -j DROP 2>/dev/null || true

  if ! sudo iptables -C DOCKER-USER -j ACCEPT 2>/dev/null; then
    sudo iptables -I DOCKER-USER 1 -j ACCEPT
  fi
  if ! sudo iptables -C FORWARD -j ACCEPT 2>/dev/null; then
    sudo iptables -I FORWARD 1 -j ACCEPT
  fi

  if ! sudo iptables -t nat -C POSTROUTING -j MASQUERADE 2>/dev/null; then
    sudo iptables -t nat -I POSTROUTING 1 -j MASQUERADE
  fi
}

apply_fw_rules

docker events --filter 'event=start' 2>/dev/null | while read line; do
  sleep 1
  apply_fw_rules
done
INNER_EOF
sudo chmod +x /usr/local/bin/fw-watcher.sh
sudo nohup /usr/local/bin/fw-watcher.sh > /dev/null 2>&1 &
EOF

                local vm_ip=$(colima ssh -- ip addr show col0 2>/dev/null | grep 'inet ' | awk '{ print $2 }' | cut -d/ -f1)
                if [ -n "$vm_ip" ]; then
                    echo -e "Detected Colima VM IP: ${GREEN}${vm_ip}${NC}"

                    for net_name in "net-edge" "net-db"; do
                        docker network create "$net_name" 2>/dev/null || true
                        local subnet=$(docker network inspect "$net_name" -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}' 2>/dev/null || true)
                        if [ -n "$subnet" ]; then
                            echo -e "Routing subnet ${subnet} ($net_name) -> ${vm_ip}..."
                            sudo route -n delete -net "$subnet" >/dev/null 2>&1 || true
                            sudo route -n add -net "$subnet" "$vm_ip" >/dev/null 2>&1 || true
                        fi
                    done

                    update_static_hosts "$vm_ip"
                fi
            else
                echo -e "${RED}❌ Error: Colima is not installed.${NC}"
                exit 1
            fi
            ;;
        docker)
            if ! docker info >/dev/null 2>&1; then
                if [ -d "/Applications/Docker.app" ]; then
                    echo -e "🚀 Starting Docker Desktop..."
                    open -a Docker
                    local retries=0
                    while ! docker info >/dev/null 2>&1 && [ $retries -lt 15 ]; do
                        sleep 1
                        retries=$((retries + 1))
                    done
                fi
            fi
            if docker info >/dev/null 2>&1; then
                echo -e "${GREEN}✓ Docker engine is ready.${NC}"
                update_static_hosts
            else
                echo -e "${RED}❌ Error: Docker daemon is not accessible.${NC}"
                exit 1
            fi
            ;;
        *)
            echo -e "${RED}❌ Unknown engine: $engine (supported: auto, orbstack, colima, docker)${NC}"
            exit 1
            ;;
    esac
}

cmd_install() {
    echo -e "${BLUE}==> [macOS] Installing Oopsbox Local Dev Environment...${NC}"

    # Initialize .env and oopsbox.yml from examples
    if [ ! -f .env ]; then
        if [ -f .env.example ]; then
            echo -e "Creating .env with auto-generated secure credentials..."
            cp .env.example .env
            local secret=$(generate_password)
            local mysql_pass=$(generate_password)
            local pg_pass=$(generate_password)

            sed -i.bak -e "s|OOPS_SECRET=.*|OOPS_SECRET=${secret}|g" \
                       -e "s|MYSQL_ROOT_PASSWORD=.*|MYSQL_ROOT_PASSWORD=${mysql_pass}|g" \
                       -e "s|POSTGRES_PASSWORD=.*|POSTGRES_PASSWORD=${pg_pass}|g" .env
            rm -f .env.bak
            echo -e "${GREEN}✓ .env created successfully.${NC}"
        fi
    else
        echo -e "Existing .env found. Keeping current credentials."
    fi

    if [ ! -f oopsbox.yml ] && [ -f oopsbox.yml.example ]; then
        cp oopsbox.yml.example oopsbox.yml
        echo -e "${GREEN}✓ oopsbox.yml initialized from oopsbox.yml.example.${NC}"
    fi

    # Prepare Storage & Data Directories
    mkdir -p data backups data/oops
    echo -e "${GREEN}✓ Storage and data directories initialized.${NC}"

    # Setup macOS DNS Resolver
    local tld=$(get_dns_tld)
    echo -e "Preparing macOS DNS resolver directory (/etc/resolver for *.$tld)..."
    sudo mkdir -p /etc/resolver
    local oops_ip=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{break}}{{end}}' oops 2>/dev/null || true)
    if [ -n "$oops_ip" ]; then
        sudo tee "/etc/resolver/$tld" > /dev/null <<EOF
nameserver $oops_ip
EOF
        echo -e "${GREEN}✓ /etc/resolver/$tld configured with nameserver ${oops_ip}.${NC}"
    else
        sudo touch "/etc/resolver/$tld"
        echo -e "${GREEN}✓ /etc/resolver/$tld prepared (will be bound to container IP on 'oopsbox start').${NC}"
    fi

    # Link oopsbox to global PATH (/usr/local/bin/oopsbox)
    echo -e "Registering 'oopsbox' to global system PATH..."
    if [ -d "/usr/local/bin" ] && [ -w "/usr/local/bin" ]; then
        ln -sf "$BIN_DIR/oopsbox" /usr/local/bin/oopsbox
        echo -e "${GREEN}✓ Symlink created: /usr/local/bin/oopsbox -> $BIN_DIR/oopsbox${NC}"
    elif sudo -n true 2>/dev/null || [ -n "$SUDO_USER" ]; then
        sudo ln -sf "$BIN_DIR/oopsbox" /usr/local/bin/oopsbox
        echo -e "${GREEN}✓ Symlink created: /usr/local/bin/oopsbox -> $BIN_DIR/oopsbox${NC}"
    else
        mkdir -p "$HOME/.local/bin"
        ln -sf "$BIN_DIR/oopsbox" "$HOME/.local/bin/oopsbox"
        echo -e "${GREEN}✓ Symlink created: $HOME/.local/bin/oopsbox${NC}"
    fi

    # 5. Runtime Engine Setup & Network Optimization
    start_and_configure_engine

    echo -e "\n${GREEN}===============================================${NC}"
    echo -e "${GREEN}🎉 Oopsbox installation complete!${NC}"
    echo -e "You can now run ${BLUE}oopsbox${NC} from any terminal directory!"
    echo -e "Next steps:"
    echo -e "  1. Start services:     ${BLUE}oopsbox start${NC}"
    echo -e "  2. Install HTTPS cert: ${BLUE}oopsbox install-cert${NC}"
    echo -e "${GREEN}===============================================${NC}"
}

cmd_start() {
    # Load .env if present
    if [ -f .env ]; then
        set -a
        source .env
        set +a
    fi

    echo -e "${BLUE}==> [macOS] Starting Oopsbox Environment...${NC}"

    # Check, start and configure runtime engine
    start_and_configure_engine

    # Start default services via oops binary or fallback
    if run_oops up; then
        :
    else
        echo -e "Starting stacks via docker compose fallback..."
        docker compose -f stacks/edge/compose.yml up -d
    fi

    # Configure macOS DNS Resolver pointing directly to oops container IP
    local tld=$(get_dns_tld)
    local oops_ip=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{break}}{{end}}' oops 2>/dev/null || true)
    if [ -n "$oops_ip" ]; then
        echo -e "Configuring macOS DNS resolver for *.$tld domain (nameserver ${oops_ip})..."
        sudo mkdir -p /etc/resolver
        sudo tee "/etc/resolver/$tld" > /dev/null <<EOF
nameserver $oops_ip
EOF
        echo -e "${GREEN}✓ /etc/resolver/$tld configured with nameserver ${oops_ip}.${NC}"
    fi

    echo -e "\n${GREEN}✨ Oopsbox is up and running!${NC}"
    echo -e "Use ${BLUE}oops${NC} to manage stacks and profiles (e.g. ${BLUE}oops up @lab${NC}, ${BLUE}oops switch${NC}, ${BLUE}oops status${NC})."
}

cmd_install_cert() {
    echo -e "${BLUE}==> [macOS] Installing Caddy Local Root CA Certificate...${NC}"

    local cert_src="data/caddy/pki/authorities/local/root.crt"
    local tmp_cert="backups/caddy-root.crt"

    if [ ! -f "$cert_src" ]; then
        if docker ps | grep -q "caddy-proxy"; then
            docker cp caddy-proxy:/data/caddy/pki/authorities/local/root.crt "$tmp_cert" 2>/dev/null || true
        fi
    else
        cp "$cert_src" "$tmp_cert"
    fi

    if [ ! -f "$tmp_cert" ] && [ ! -f "$cert_src" ]; then
        echo -e "${RED}❌ Error: Caddy root.crt not found. Please ensure caddy-proxy is started.${NC}"
        echo -e "Run: ${BLUE}oopsbox start${NC} first, then try again."
        exit 1
    fi

    local cert_file="${tmp_cert:-$cert_src}"

    echo -e "Adding trusted certificate to macOS System Keychain..."
    sudo security add-trusted-cert -d -r trustRoot -k /Library/Keychains/System.keychain "$cert_file"
    echo -e "${GREEN}✓ Certificate added to macOS Keychain.${NC}"

    local ff_profiles="$HOME/Library/Application Support/Firefox/Profiles"
    if [ -d "$ff_profiles" ]; then
        echo -e "Configuring Firefox Enterprise Roots..."
        for ff_dir in "$ff_profiles"/*; do
            if [ -d "$ff_dir" ]; then
                local user_js="$ff_dir/user.js"
                touch "$user_js"
                if ! grep -q "security.enterprise_roots.enabled" "$user_js" 2>/dev/null; then
                    echo 'user_pref("security.enterprise_roots.enabled", true);' >> "$user_js"
                fi
            fi
        done
        echo -e "${GREEN}✓ Firefox configured to trust macOS Keychain certificates.${NC}"
    fi

    rm -f "$tmp_cert"
    echo -e "\n${GREEN}🔒 Local HTTPS Certificate is trusted! (Green lock active for *.web.oops)${NC}"
}

cmd_stop() {
    echo -e "${YELLOW}==> [macOS] Stopping Oopsbox Environment...${NC}"
    if run_oops down; then
        :
    else
        echo -e "Stopping stacks via docker compose fallback..."
        for dir in stacks/apps stacks/tool stacks/db stacks/edge; do
            if [ -f "$dir/compose.yml" ]; then
                docker compose -f "$dir/compose.yml" down 2>/dev/null || true
            elif [ -f "$dir/compose.yaml" ]; then
                docker compose -f "$dir/compose.yaml" down 2>/dev/null || true
            fi
        done
    fi
    echo -e "${GREEN}✓ Oopsbox stopped.${NC}"
}

cmd_switch() {
    local target_raw="$1"
    if [ -z "$target_raw" ]; then
        echo -e "${RED}Error: Target oopsbox directory path is required.${NC}"
        echo -e "Usage: ${BLUE}oopsbox switch <path/to/oopsbox>${NC}"
        exit 1
    fi

    local target_path
    if [[ "$target_raw" == ~* ]]; then
        target_path="${target_raw/#\~/$HOME}"
    else
        target_path="$(cd "$target_raw" 2>/dev/null && pwd || echo "$target_raw")"
    fi

    if [ ! -d "$target_path" ]; then
        echo -e "${RED}Error: Directory not found: $target_path${NC}"
        exit 1
    fi

    if [ ! -d "$target_path/stacks" ] && [ ! -f "$target_path/oops.yml" ] && [ ! -f "$target_path/oopsbox.yml" ]; then
        echo -e "${RED}Error: $target_path is not a valid Oopsbox workspace (missing stacks/ or oops.yml).${NC}"
        exit 1
    fi

    echo -e "${BLUE}==> Switching Oopsbox context to: $target_path${NC}"

    # Step 1: Clean and tear down current containers to release names and ports
    echo -e "${YELLOW}==> Tearing down active containers from current workspace...${NC}"
    cmd_stop

    # Step 2: Re-link global CLI symlink
    local target_bin="$target_path/bin/oopsbox"
    if [ -f "$target_bin" ]; then
        if [ -d "/usr/local/bin" ] && [ -w "/usr/local/bin" ]; then
            ln -sf "$target_bin" /usr/local/bin/oopsbox
        elif [ -d "/usr/local/bin" ]; then
            sudo ln -sf "$target_bin" /usr/local/bin/oopsbox 2>/dev/null || true
        else
            mkdir -p "$HOME/.local/bin"
            ln -sf "$target_bin" "$HOME/.local/bin/oopsbox"
        fi
    fi

    # Step 3: Start target environment
    echo -e "${BLUE}==> Booting up target environment...${NC}"
    (cd "$target_path" && ./bin/oopsbox start)

    echo -e "\n${GREEN}=======================================================${NC}"
    echo -e "${GREEN}✓ Successfully switched active Oopsbox to: $target_path${NC}"
    echo -e "To ensure 'oops' targets this box outside its directory, run:"
    echo -e "  export OOPSBOX_DIR=\"$target_path\""
    echo -e "${GREEN}=======================================================${NC}"
}

case "$1" in
    install)
        cmd_install
        ;;
    start)
        cmd_start
        ;;
    install-cert)
        cmd_install_cert
        ;;
    stop)
        cmd_stop
        ;;
    switch)
        cmd_switch "$2"
        ;;
    *)
        echo -e "${BLUE}Oopsbox Workstation Tool (macOS)${NC}"
        echo -e "Usage: oopsbox <command>"
        echo -e ""
        echo -e "Commands:"
        echo -e "  ${GREEN}install${NC}         Initialize .env, storage, macOS DNS resolver, and global PATH"
        echo -e "  ${GREEN}start${NC}           Start VM engine, configure networking/DNS, and boot oops"
        echo -e "  ${GREEN}install-cert${NC}    Install Caddy Local Root SSL certificate into macOS Keychain"
        echo -e "  ${GREEN}stop${NC}            Stop runtime services (runs oops down)"
        echo -e "  ${GREEN}switch <path>${NC}   Tear down current box, switch context, and start target oopsbox"
        echo -e ""
        echo -e "For managing stacks and profiles, use ${BLUE}oops <command>${NC} (e.g. oops up, oops switch, oops status)."
        ;;
esac
