# ==============================================================================
# Oops Stack Environment Configuration (.env.example)
# ==============================================================================

# Project / Stack Domain
DOMAIN=example.com

# Oops Webhook Engine & Secret
PORT=8080
OOPS_SECRET=change_this_to_a_secure_token

# Database Credentials
MYSQL_ROOT_PASSWORD=change_this_root_password
POSTGRES_USER=app_user
POSTGRES_DB=app_db
POSTGRES_PASSWORD=change_this_pg_password

# Backup & Healthcheck Timeouts
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=./backups
HEALTHCHECK_TIMEOUT_SECONDS=600
HEALTHCHECK_INTERVAL_SECONDS=3
STOP_TIMEOUT_SECONDS=30
