#!/usr/bin/env bash
set -e

# DevOops Local Dev Tool for macOS
# Resolve real directory path even if called via symlink
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
OOPSBOX_DIR="$(cd -P "$BIN_DIR/.." && pwd)"

cd "$OOPSBOX_DIR"

# Color formatting
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

generate_password() {
    if command -v openssl >/dev/null 2>&1; then
        openssl rand -base64 15 | tr -dc 'A-Za-z0-9' | head -c 20
    else
        LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 20
    fi
}

update_static_hosts() {
    local vm_ip="$1"
    local host_ip="$2"

    if [ -z "$vm_ip" ] && command -v colima >/dev/null 2>&1 && colima status >/dev/null 2>&1; then
        vm_ip=$(colima ssh -- ip addr show col0 2>/dev/null | grep 'inet ' | awk '{ print $2 }' | cut -d/ -f1)
    fi

    if [ -n "$vm_ip" ]; then
        if [ -z "$host_ip" ]; then
            host_ip=$(echo "$vm_ip" | sed 's/\.[0-9]*$/\.1/')
        fi

        mkdir -p config/oops
        cat > config/oops/hosts <<EOF
# ==============================================================================
# Oops Static Hosts (Auto-generated by devoops)
# ==============================================================================
$host_ip host.oops
$vm_ip vm.oops
EOF
        echo -e "${GREEN}✓ config/oops/hosts updated (host.oops -> $host_ip, vm.oops -> $vm_ip).${NC}"
    fi
}

get_colima_start_cmd() {
    local yaml_file=""
    for f in "stacks/oops.yml" "stacks/oops.yaml" "oops.yml" "oops.yaml"; do
        if [ -f "$f" ]; then
            yaml_file="$f"
            break
        fi
    done

    local cpu="${COLIMA_CPU}"
    local mem="${COLIMA_MEMORY}"
    local disk="${COLIMA_DISK}"
    local vm_type="${COLIMA_VM_TYPE}"

    if [ -n "$yaml_file" ]; then
        if [ -z "$cpu" ]; then
            cpu=$(awk -F: '/^[[:space:]]*colima:[[:space:]]*$/ {in_col=1; next} in_col && /^[a-zA-Z]/ {in_col=0} in_col && $1 ~ /^[[:space:]]*cpu[[:space:]]*$/ {sub(/#.*/, "", $2); gsub(/[[:space:]]/, "", $2); print $2}' "$yaml_file" 2>/dev/null | head -n 1)
        fi
        if [ -z "$mem" ]; then
            mem=$(awk -F: '/^[[:space:]]*colima:[[:space:]]*$/ {in_col=1; next} in_col && /^[a-zA-Z]/ {in_col=0} in_col && $1 ~ /^[[:space:]]*memory[[:space:]]*$/ {sub(/#.*/, "", $2); gsub(/[[:space:]]/, "", $2); print $2}' "$yaml_file" 2>/dev/null | head -n 1)
        fi
        if [ -z "$disk" ]; then
            disk=$(awk -F: '/^[[:space:]]*colima:[[:space:]]*$/ {in_col=1; next} in_col && /^[a-zA-Z]/ {in_col=0} in_col && $1 ~ /^[[:space:]]*disk[[:space:]]*$/ {sub(/#.*/, "", $2); gsub(/[[:space:]]/, "", $2); print $2}' "$yaml_file" 2>/dev/null | head -n 1)
        fi
        if [ -z "$vm_type" ]; then
            vm_type=$(awk -F: '/^[[:space:]]*colima:[[:space:]]*$/ {in_col=1; next} in_col && /^[a-zA-Z]/ {in_col=0} in_col && $1 ~ /^[[:space:]]*vm_type[[:space:]]*$/ {sub(/#.*/, "", $2); gsub(/[[:space:]]/, "", $2); print $2}' "$yaml_file" 2>/dev/null | head -n 1)
        fi
    fi

    cpu="${cpu:-4}"
    mem="${mem:-4}"
    vm_type="${vm_type:-vz}"

    if [ -n "$COLIMA_START_ARGS" ]; then
        echo "colima start ${COLIMA_START_ARGS}"
    else
        local cmd="colima start --cpu ${cpu} --memory ${mem} --vm-type=${vm_type} --network-address"
        if [ -n "$disk" ]; then
            cmd="${cmd} --disk ${disk}"
        fi
        echo "$cmd"
    fi
}

cmd_install() {
    echo -e "${BLUE}==> [macOS] Installing DevOops Local Dev Environment...${NC}"

    # 1. Initialize .env from .env.example
    if [ ! -f .env ]; then
        if [ -f .env.example ]; then
            echo -e "Creating .env with auto-generated secure credentials..."
            cp .env.example .env
            local secret=$(generate_password)
            local mysql_pass=$(generate_password)
            local pg_pass=$(generate_password)

            sed -i.bak -e "s|OOPS_SECRET=.*|OOPS_SECRET=${secret}|g" \
                       -e "s|MYSQL_ROOT_PASSWORD=.*|MYSQL_ROOT_PASSWORD=${mysql_pass}|g" \
                       -e "s|POSTGRES_PASSWORD=.*|POSTGRES_PASSWORD=${pg_pass}|g" .env
            rm -f .env.bak
            echo -e "${GREEN}✓ .env created successfully.${NC}"
        fi
    else
        echo -e "Existing .env found. Keeping current credentials."
    fi

    # 2. Prepare Storage & Config Directories
    mkdir -p data backups config/oops
    echo -e "${GREEN}✓ Storage and config directories initialized.${NC}"

    # 3. Setup macOS DNS Resolver
    echo -e "Preparing macOS DNS resolver directory (/etc/resolver)..."
    sudo mkdir -p /etc/resolver
    local oops_ip=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{break}}{{end}}' oops 2>/dev/null || true)
    if [ -n "$oops_ip" ]; then
        sudo tee /etc/resolver/oops > /dev/null <<EOF
nameserver $oops_ip
EOF
        echo -e "${GREEN}✓ /etc/resolver/oops configured with nameserver ${oops_ip}.${NC}"
    else
        sudo touch /etc/resolver/oops
        echo -e "${GREEN}✓ /etc/resolver/oops prepared (will be bound to container IP on 'devoops start').${NC}"
    fi

    # 4. Link devoops to global PATH (/usr/local/bin/devoops)
    echo -e "Registering 'devoops' to global system PATH..."
    if [ -d "/usr/local/bin" ] && [ -w "/usr/local/bin" ]; then
        ln -sf "$BIN_DIR/devoops" /usr/local/bin/devoops
        echo -e "${GREEN}✓ Symlink created: /usr/local/bin/devoops -> $BIN_DIR/devoops${NC}"
    elif sudo -n true 2>/dev/null || [ -n "$SUDO_USER" ]; then
        sudo ln -sf "$BIN_DIR/devoops" /usr/local/bin/devoops
        echo -e "${GREEN}✓ Symlink created: /usr/local/bin/devoops -> $BIN_DIR/devoops${NC}"
    else
        mkdir -p "$HOME/.local/bin"
        ln -sf "$BIN_DIR/devoops" "$HOME/.local/bin/devoops"
        echo -e "${GREEN}✓ Symlink created: $HOME/.local/bin/devoops${NC}"
    fi

    # 5. Colima VM Setup & Internal Optimization
    if command -v colima >/dev/null 2>&1; then
        if ! colima status >/dev/null 2>&1; then
            local colima_start_cmd=$(get_colima_start_cmd)
            echo -e "🚀 Starting Colima VM (${colima_start_cmd})..."
            eval "$colima_start_cmd"
        fi

        echo -e "⚙️  Configuring Colima VM Internal Settings & Network..."
        colima ssh -- sudo bash << 'EOF' 2>/dev/null || true
# 1. Network Forwarding & Routing Security
cat > /etc/sysctl.d/99-oops.conf << 'SYS'
net.ipv4.ip_forward = 1
net.ipv4.conf.all.rp_filter = 0
net.ipv4.conf.default.rp_filter = 0
net.ipv4.conf.all.accept_local = 1
net.ipv4.conf.send_redirects = 1
net.ipv4.conf.all.send_redirects = 1
net.bridge.bridge-nf-call-iptables = 0
net.ipv6.conf.all.disable_ipv6 = 1
SYS
sysctl --system >/dev/null 2>&1 || true

# 2. Prevent DNS conflicts on port 53
systemctl disable --now systemd-resolved 2>/dev/null || true
if command -v apt-get >/dev/null 2>&1; then
    export DEBIAN_FRONTEND=noninteractive
    apt-get remove -y -qq dnsmasq-base >/dev/null 2>&1 || true
fi

# 3. VM DNS Resolv
cat > /etc/resolv.conf << 'RES'
nameserver 127.0.0.1
nameserver 1.1.1.1
nameserver 8.8.8.8
RES

# 4. Flush raw firewall rules
nft flush chain ip raw PREROUTING 2>/dev/null || true
EOF
        update_static_hosts
    fi

    echo -e "\n${GREEN}===============================================${NC}"
    echo -e "${GREEN}🎉 DevOops installation complete!${NC}"
    echo -e "You can now run ${BLUE}devoops${NC} from any terminal directory!"
    echo -e "Next steps:"
    echo -e "  1. Start services:     ${BLUE}devoops start${NC}"
    echo -e "  2. Install HTTPS cert: ${BLUE}devoops install-cert${NC}"
    echo -e "${GREEN}===============================================${NC}"
}

cmd_start() {
    local target_arg="$1"

    # Load .env if present
    if [ -f .env ]; then
        set -a
        source .env
        set +a
    fi

    # Determine start target
    local start_target=""
    if [ -n "$target_arg" ]; then
        if [[ "$target_arg" == @* ]] || [[ "$target_arg" == /* ]]; then
            start_target="$target_arg"
        elif [ -d "stacks/$target_arg" ]; then
            start_target="/$target_arg"
        else
            start_target="@$target_arg"
        fi
    elif [ -n "$OOPS_DEFAULT_GROUP" ]; then
        start_target="@${OOPS_DEFAULT_GROUP#@}"
    fi

    echo -e "${BLUE}==> [macOS] Starting DevOops Environment (${start_target:-all services})...${NC}"

    # Check, start and configure Colima if installed
    if command -v colima >/dev/null 2>&1; then
        if ! colima status >/dev/null 2>&1; then
            local colima_start_cmd=$(get_colima_start_cmd)
            echo -e "🚀 ${YELLOW}Colima VM is stopped. Starting Colima (${colima_start_cmd})...${NC}"
            eval "$colima_start_cmd"
        fi

        # Check and restore Docker internal iptables chains if needed
        if ! colima ssh -- sudo iptables -n -L DOCKER-FORWARD >/dev/null 2>&1; then
            echo -e "🌀 Restoring Docker daemon iptables chains in Colima VM..."
            colima ssh -- sudo systemctl restart docker 2>/dev/null || true
            sleep 2
        fi

        echo -e "🌀 Configuring Colima VM Network and Firewall..."

        colima ssh -- sudo pkill -f /usr/local/bin/fw-watcher.sh 2>/dev/null || true
        colima ssh << 'EOF' 2>/dev/null || true
sudo tee /usr/local/bin/fw-watcher.sh > /dev/null << 'INNER_EOF'
#!/bin/sh

apply_fw_rules() {
  sudo nft flush chain ip raw PREROUTING 2>/dev/null
  sudo iptables -D DOCKER -j DROP 2>/dev/null

  if ! sudo iptables -C FORWARD -j ACCEPT 2>/dev/null; then
    sudo iptables -I FORWARD 1 -j ACCEPT
  fi

  if ! sudo iptables -t nat -C POSTROUTING -j MASQUERADE 2>/dev/null; then
    sudo iptables -t nat -I POSTROUTING 1 -j MASQUERADE
  fi
}

apply_fw_rules

docker events --filter 'event=start' 2>/dev/null | while read line; do
  sleep 1
  apply_fw_rules
done
INNER_EOF
sudo chmod +x /usr/local/bin/fw-watcher.sh
sudo nohup /usr/local/bin/fw-watcher.sh > /dev/null 2>&1 &
EOF

        local vm_ip=$(colima ssh -- ip addr show col0 2>/dev/null | grep 'inet ' | awk '{ print $2 }' | cut -d/ -f1)
        if [ -n "$vm_ip" ]; then
            echo -e "Detected Colima VM IP: ${GREEN}${vm_ip}${NC}"

            for net_name in "net-edge" "net-db" "net-apps"; do
                docker network create "$net_name" 2>/dev/null || true
                local subnet=$(docker network inspect "$net_name" -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}' 2>/dev/null || true)
                if [ -n "$subnet" ]; then
                    echo -e "Routing subnet ${subnet} ($net_name) -> ${vm_ip}..."
                    sudo route -n delete -net "$subnet" >/dev/null 2>&1 || true
                    sudo route -n add -net "$subnet" "$vm_ip" >/dev/null 2>&1 || true
                fi
            done

            update_static_hosts "$vm_ip"
        fi
    fi

    # Start services via oops binary or fallback
    if command -v oops >/dev/null 2>&1; then
        if [ -n "$start_target" ]; then
            oops up "$start_target"
        else
            oops up
        fi
    else
        echo -e "Starting stacks via docker compose fallback..."
        case "$start_target" in
            @minimal)
                docker compose -f stacks/edge/compose.yml up -d
                ;;
            @core)
                docker compose -f stacks/edge/compose.yml up -d
                docker compose -f stacks/db/compose.yml up -d mysql redis
                docker compose -f stacks/utils/compose.yml up -d
                ;;
            @pg)
                docker compose -f stacks/edge/compose.yml up -d
                docker compose -f stacks/db/compose.yml up -d postgres redis
                docker compose -f stacks/utils/compose.yml up -d
                ;;
            *)
                docker compose -f stacks/edge/compose.yml up -d
                docker compose -f stacks/db/compose.yml up -d
                docker compose -f stacks/utils/compose.yml up -d
                ;;
        esac
    fi

    # Configure macOS DNS Resolver pointing directly to oops container IP
    local oops_ip=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{break}}{{end}}' oops 2>/dev/null || true)
    if [ -n "$oops_ip" ]; then
        echo -e "Configuring macOS DNS resolver for *.oops domain (nameserver ${oops_ip})..."
        sudo mkdir -p /etc/resolver
        sudo tee /etc/resolver/oops > /dev/null <<EOF
nameserver $oops_ip
EOF
        echo -e "${GREEN}✓ /etc/resolver/oops configured with nameserver ${oops_ip}.${NC}"
    fi

    echo -e "\n${GREEN}✨ DevOops is up and running!${NC}"
}

cmd_install_cert() {
    echo -e "${BLUE}==> [macOS] Installing Caddy Local Root CA Certificate...${NC}"

    local cert_src="data/caddy/pki/authorities/local/root.crt"
    local tmp_cert="backups/caddy-root.crt"

    if [ ! -f "$cert_src" ]; then
        if docker ps | grep -q "caddy-proxy"; then
            docker cp caddy-proxy:/data/caddy/pki/authorities/local/root.crt "$tmp_cert" 2>/dev/null || true
        fi
    else
        cp "$cert_src" "$tmp_cert"
    fi

    if [ ! -f "$tmp_cert" ] && [ ! -f "$cert_src" ]; then
        echo -e "${RED}❌ Error: Caddy root.crt not found. Please ensure caddy-proxy is started.${NC}"
        echo -e "Run: ${BLUE}devoops start${NC} first, then try again."
        exit 1
    fi

    local cert_file="${tmp_cert:-$cert_src}"

    echo -e "Adding trusted certificate to macOS System Keychain..."
    sudo security add-trusted-cert -d -r trustRoot -k /Library/Keychains/System.keychain "$cert_file"
    echo -e "${GREEN}✓ Certificate added to macOS Keychain.${NC}"

    local ff_profiles="$HOME/Library/Application Support/Firefox/Profiles"
    if [ -d "$ff_profiles" ]; then
        echo -e "Configuring Firefox Enterprise Roots..."
        for ff_dir in "$ff_profiles"/*; do
            if [ -d "$ff_dir" ]; then
                local user_js="$ff_dir/user.js"
                touch "$user_js"
                if ! grep -q "security.enterprise_roots.enabled" "$user_js" 2>/dev/null; then
                    echo 'user_pref("security.enterprise_roots.enabled", true);' >> "$user_js"
                fi
            fi
        done
        echo -e "${GREEN}✓ Firefox configured to trust macOS Keychain certificates.${NC}"
    fi

    rm -f "$tmp_cert"
    echo -e "\n${GREEN}🔒 Local HTTPS Certificate is trusted! (Green lock active for *.web.oops)${NC}"
}

cmd_stop() {
    echo -e "${YELLOW}==> [macOS] Stopping DevOops Environment...${NC}"
    if command -v oops >/dev/null 2>&1; then
        oops down
    else
        docker compose -f stacks/utils/compose.yml down 2>/dev/null || true
        docker compose -f stacks/db/compose.yml down 2>/dev/null || true
        docker compose -f stacks/edge/compose.yml down 2>/dev/null || true
    fi
    echo -e "${GREEN}✓ DevOops stopped.${NC}"
}

case "$1" in
    install)
        cmd_install
        ;;
    start)
        cmd_start "$2"
        ;;
    install-cert|install-cer)
        cmd_install_cert
        ;;
    stop)
        cmd_stop
        ;;
    status)
        docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
        ;;
    *)
        echo -e "${BLUE}DevOops Local Dev Tool (macOS)${NC}"
        echo -e "Usage: devoops <command> [group]"
        echo -e ""
        echo -e "Commands:"
        echo -e "  ${GREEN}install${NC}              Initialize .env, storage, macOS DNS resolver, and global PATH"
        echo -e "  ${GREEN}start [group]${NC}        Start default group (OOPS_DEFAULT_GROUP) or specified group (e.g. @pg, @core)"
        echo -e "  ${GREEN}install-cert${NC}         Install Caddy Local Root SSL certificate into macOS Keychain"
        echo -e "  ${GREEN}stop${NC}                 Stop all running stacks"
        echo -e "  ${GREEN}status${NC}               Show status of running containers"
        ;;
esac
